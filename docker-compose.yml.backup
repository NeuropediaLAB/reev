version: '3.8'

services:
  # PostgreSQL - Base de datos principal
  postgres:
    image: postgres:15-alpine
    container_name: reev-postgres
    environment:
      POSTGRES_USER: reev
      POSTGRES_PASSWORD: reev_password
      POSTGRES_DB: reev
    ports:
      - "5432:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    restart: unless-stopped
    networks:
      - reev-network

  # Redis - Cache
  redis:
    image: redis:7-alpine
    container_name: reev-redis
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
    restart: unless-stopped
    networks:
      - reev-network

  # Annonars - Servicio de anotaciones
  annonars:
    build:
      context: ./annonars
      dockerfile: utils/docker/Dockerfile
    ports:
      - "3001:8080"
    environment:
      - RUST_LOG=info
    volumes:
      - ./data/annonars:/data:ro
    restart: unless-stopped
    networks:
      - reev-network
    depends_on:
      - postgres
      - redis

  # Mehari - Consecuencias moleculares
  mehari:
    build:
      context: ./mehari
      dockerfile: utils/docker/Dockerfile
    container_name: reev-mehari
    ports:
      - "3002:8080"
    environment:
      - RUST_LOG=info
    volumes:
      - ./data/mehari:/data:ro
    restart: unless-stopped
    networks:
      - reev-network
    depends_on:
      - postgres
      - redis

  # REEV Frontend
  reev-frontend:
    build:
      context: ./reev-frontend
      dockerfile: utils/docker/Dockerfile
    container_name: reev-frontend
    ports:
      - "3003:80"
    environment:
      - VITE_API_BASE_URL=http://localhost:3000
      - VITE_ANNONARS_URL=http://annonars:8080
      - VITE_MEHARI_URL=http://mehari:8080
    restart: unless-stopped
    networks:
      - reev-network
    depends_on:
      - annonars
      - mehari
      - postgres
      - redis

volumes:
  postgres-data:
    driver: local
  redis-data:
    driver: local

networks:
  reev-network:
    driver: bridge
